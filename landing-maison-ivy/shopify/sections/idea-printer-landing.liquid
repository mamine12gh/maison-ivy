      {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}
      <a href="mailto:{{ s.contact_email }}">Contact</a>
    </nav>
    <div class="ip-pay" aria-label="Payment methods">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ shop.domain }}</p>
  </div>
</footer>

<!-- S16 Sticky bar -->
<div class="ip-sticky" data-ip-sticky>
  <div class="in">
    <span class="thumb">{%- render 'ip-media', image: img_23b, id: 'IMG-23', label: 'Kit', size: '', ratio: '1/1', sizes: '48px' -%}</span>
    <span class="t"><b data-sticky-price>{{ v_creative.price | money_without_trailing_zeros }}</b><span data-sticky-name>Creative Kit</span></span>
    <button class="ip-cta" type="button" data-ip-sticky-add>{{ cta }}</button>
  </div>
</div>

<!-- S17 Cart drawer -->
<div class="ip-scrim" data-ip-scrim></div>
<aside class="ip-drawer" data-ip-drawer role="dialog" aria-modal="true" aria-label="Cart">
  <div class="hd"><b data-ip-drawer-title>✓ Added to cart</b><button class="ip-x" type="button" data-ip-close aria-label="Close cart">×</button></div>
  <div class="bd">
    <div data-ip-lines></div>
    {%- if s.refill_product != blank -%}
    <div class="ip-upsell" data-ip-upsell>
      <p><b>Add 5 rolls?</b>About 300 more stickers, for road trips.</p>
      <button type="button" data-ip-upsell-add data-variant="{{ s.refill_product.selected_or_first_available_variant.id }}">+ {{ s.refill_product.price | money_without_trailing_zeros }}</button>
    </div>
    {%- endif -%}
  </div>
  <div class="ft">
    <div class="sum"><span>Total</span><span data-ip-cart-total>{{ cart.total_price | money }}</span></div>
    <p class="ship">✓ Free shipping · ships within 24 h</p>
    <a class="ip-cta" href="/checkout">Complete my order <span class="arr" aria-hidden="true">→</span></a>
  </div>
</aside>
</div>

<script>
(function () {
  var root = document.getElementById('ip-root');
  if (!root) return;
  var $ = function (s) { return root.querySelector(s); };
  var $$ = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
  var KITS = {
    starter:  { name: 'Starter Kit',  price: {{ v_starter.price | money_without_trailing_zeros | json }},  was: '', save: '' },
    creative: { name: 'Creative Kit', price: {{ v_creative.price | money_without_trailing_zeros | json }}, was: {{ creative_value | money_without_trailing_zeros | json }}, save: {{ creative_save | money_without_trailing_zeros | prepend: 'You save ' | json }} },
    siblings: { name: 'Siblings Kit', price: {{ v_siblings.price | money_without_trailing_zeros | json }}, was: {{ siblings_value | money_without_trailing_zeros | json }}, save: {{ siblings_save | money_without_trailing_zeros | prepend: 'You save ' | json }} }
  };
  var moneyFormat = {{ shop.money_format | json }};
  function fmt(cents) {
    var v = (cents / 100).toFixed(2);
    var o = '{' + '{';
    var out = moneyFormat.split(o + 'amount}}').join(v).split(o + ' amount }}').join(v);
    return out.indexOf(o) === -1 ? out : '$' + v;
  }
  var variantInput = $('[data-ip-variant]');

  // S7 kit selection
  function currentKit() { var c = $('input[name="ip-kit"]:checked'); return c ? c : null; }
  function renderKit() {
    var c = currentKit(); if (!c) return;
    var k = KITS[c.dataset.kit];
    variantInput.value = c.value;
    $$('[data-box]').forEach(function (u) { u.hidden = u.dataset.box !== c.dataset.kit; });
    $('[data-box-note]').hidden = c.dataset.kit === 'starter';
    $('[data-total]').textContent = k.price;
    $('[data-was]').textContent = k.was; $('[data-was]').hidden = !k.was;
    $('[data-save]').textContent = k.save; $('[data-save]').hidden = !k.save;
    $('[data-sticky-price]').textContent = k.price;
    $('[data-sticky-name]').textContent = k.name;
  }
  $$('input[name="ip-kit"]').forEach(function (r) { r.addEventListener('change', renderKit); });
  renderKit();

  // mini-question
  $$('.ip-quiz .ip-chip').forEach(function (b) {
    b.addEventListener('click', function () {
      $$('.ip-quiz .ip-chip').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
      b.setAttribute('aria-pressed', 'true');
      $('[data-ip-quiz-out]').textContent = 'Great pick! ' + b.dataset.q;
    });
  });

  // S2 gallery
  $$('[data-thumb]').forEach(function (b) {
    b.addEventListener('click', function () {
      $$('[data-thumb]').forEach(function (x) { x.setAttribute('aria-current', 'false'); });
      b.setAttribute('aria-current', 'true');
      $$('[data-slide]').forEach(function (sl) { sl.hidden = sl.dataset.slide !== b.dataset.thumb; });
    });
  });

  // S11 review filters
  $$('.ip-filters .ip-chip').forEach(function (b) {
    b.addEventListener('click', function () {
      $$('.ip-filters .ip-chip').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
      b.setAttribute('aria-pressed', 'true');
      $$('[data-ip-reviews] .ip-review').forEach(function (r) { r.hidden = !(b.dataset.f === 'all' || r.dataset.t === b.dataset.f); });
    });
  });

  // S16 sticky bar: after the hero button, hidden while the buy box is on screen
  var sticky = $('[data-ip-sticky]'), heroOut = false, buyIn = false;
  function upd() { sticky.classList.toggle('on', heroOut && !buyIn); }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (e) { heroOut = !e[0].isIntersecting && e[0].boundingClientRect.top < 0; upd(); }).observe($('[data-ip-hero-cta]'));
    new IntersectionObserver(function (e) { buyIn = e[0].isIntersecting; upd(); }, { threshold: .25 }).observe($('[data-ip-buybox]'));
  }

  // S17 cart
  var drawer = $('[data-ip-drawer]'), scrim = $('[data-ip-scrim]');
  function openCart() { drawer.classList.add('on'); scrim.classList.add('on'); $('[data-ip-close]').focus(); }
  function closeCart() { drawer.classList.remove('on'); scrim.classList.remove('on'); }
  function drawCart(cart) {
    $('[data-ip-lines]').innerHTML = cart.items.map(function (i) {
      var t = document.createElement('div'); t.textContent = i.product_title;
      var vt = document.createElement('div'); vt.textContent = i.variant_title && i.variant_title !== 'Default Title' ? i.variant_title : '';
      return '<div class="ip-line"><span><b>' + t.innerHTML + '</b><small>' + vt.innerHTML + (i.quantity > 1 ? ' × ' + i.quantity : '') + '</small></span><span><b>' + fmt(i.final_line_price) + '</b></span></div>';
    }).join('') || '<p>Your cart is empty.</p>';
    $('[data-ip-cart-total]').textContent = fmt(cart.total_price);
    var n = $('[data-ip-count]'); n.textContent = cart.item_count; n.hidden = cart.item_count === 0;
    var up = $('[data-ip-upsell]');
    if (up) { var vid = Number($('[data-ip-upsell-add]').dataset.variant); up.hidden = cart.items.some(function (i) { return i.variant_id === vid; }); }
  }
  function refresh() { return fetch('/cart.js').then(function (r) { return r.json(); }).then(drawCart); }
  function add(id, btn) {
    var err = $('[data-ip-error]'); err.hidden = true;
    if (btn) btn.disabled = true;
    return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }] }) })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.description || 'This kit could not be added.'); return j; }); })
      .then(function () { try { navigator.vibrate && navigator.vibrate(400); } catch (e) {} return refresh(); })
      .then(openCart)
      .catch(function (e) { err.textContent = e.message + ' Please try again.'; err.hidden = false; })
      .then(function () { if (btn) btn.disabled = false; });
  }
  $('#ip-product-form').addEventListener('submit', function (e) { e.preventDefault(); add(variantInput.value, $('[data-ip-add]')); });
  $('[data-ip-sticky-add]').addEventListener('click', function () { add(variantInput.value, this); });
  var upBtn = $('[data-ip-upsell-add]');
  if (upBtn) upBtn.addEventListener('click', function () { add(this.dataset.variant, this); });
  $('[data-ip-open-cart]').addEventListener('click', function () { refresh().then(openCart); });
  $('[data-ip-close]').addEventListener('click', closeCart);
  scrim.addEventListener('click', closeCart);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeCart(); });
})();
</script>


<div class="ip" id="ip-root">
{%- if s.preview_notice -%}
  <div class="ip-preview" role="note">PREVIEW · Grey boxes are image placeholders at the size to produce. Testimonials and reviews marked EXAMPLE must be replaced by real ones before you publish. Turn this notice off in the section settings.</div>
{%- endif -%}

<!-- S0 Announcement bar -->
<div class="ip-bar"><span>{{ s.bar_1 }}</span><i>·</i><span>{{ s.bar_2 }}</span><i>·</i><span>{{ s.bar_3 }}</span></div>

<!-- S1 Header -->
<header class="ip-top">
  <a class="ip-logo" href="#ip-root" aria-label="Maison Ivy">maison <span class="iv">&#305;<svg aria-hidden="true"><use href="#ip-o"/></svg></span>vy</a>
  <button class="ip-cart" type="button" data-ip-open-cart aria-label="Open cart"><svg aria-hidden="true"><use href="#ip-bag"/></svg><span class="n" data-ip-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span></button>
</header>

<main>
<!-- S2 Hero -->
<section class="ip-hero">
  <div class="ip-wrap ip-hero-grid">
    <div class="ip-hero-text">
      <div class="ip-h-top">
        <div class="ip-badges">
          <span class="ip-badge y"><svg aria-hidden="true"><use href="#ip-spark"/></svg>{{ s.starter_stickers }} stickers included</span>
          <span class="ip-badge"><svg aria-hidden="true"><use href="#ip-drop"/></svg>No ink</span>
        </div>
        <h1>If they can say it,<br><em>it prints it.</em></h1>
        {%- if show_rating -%}
        <div class="ip-stars"><span class="s" aria-hidden="true">★★★★★</span><span>{{ s.rating }}/5 · <a href="#ip-reviews">{{ shown_count }} parent reviews</a></span>{% if s.review_count < 10 %}<span class="ip-ex">EXAMPLE</span>{% endif %}</div>
        {%- endif -%}
      </div>
      <div class="ip-h-bottom">
        <p class="ip-sub">Your child presses the button, describes an idea out loud… and holds the sticker <b>5 seconds</b> later. Ready to color, ready to stick anywhere.</p>
        <div class="ip-price-line"><span class="from">From just</span><span class="p">{{ v_starter.price | money_without_trailing_zeros }}</span><span class="free">Free shipping</span></div>
        <a class="ip-cta pulse" href="#ip-offer" data-ip-hero-cta>{{ cta }} <span class="arr" aria-hidden="true">→</span></a>
        <div class="ip-reassure">
          <span><svg aria-hidden="true"><use href="#ip-lock"/></svg>Secure checkout</span>
          <span><svg aria-hidden="true"><use href="#ip-truck"/></svg>Ships within 24 h</span>
          <span><svg aria-hidden="true"><use href="#ip-return"/></svg>30 days to change your mind</span>
        </div>
      </div>
    </div>
    <div class="ip-media">
      <div class="ip-stage" data-ip-stage>
        <div class="ip-slide" data-slide="0">
          {%- if s.hero_video != blank -%}
            {{ s.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1600x', preload: 'none' }}
          {%- else -%}
            {%- render 'ip-media', image: img_01, id: 'IMG-01 / IMG-02', label: 'Hero: 8-second muted loop video (poster = action photo: child takes the sticker out of the printer)', size: '2400 × 1800 px · 4:3 · video MP4 ≤ 1.2 MB', ratio: '4/3', sizes: '(min-width: 960px) 560px, 100vw', eager: true -%}
          {%- endif -%}
        </div>
        <div class="ip-slide" data-slide="1" hidden>{%- render 'ip-media', image: img_03, id: 'IMG-03', label: 'Close-up: the sticker comes out of the slot', size: '2000 × 1500 px · 4:3', ratio: '4/3', sizes: '(min-width: 960px) 560px, 100vw' -%}</div>
        <div class="ip-slide" data-slide="2" hidden>{%- render 'ip-media', image: img_04, id: 'IMG-04', label: 'Creative Kit flat lay: everything in the box', size: '2400 × 2400 px · 1:1 (shown 4:3)', ratio: '4/3', sizes: '(min-width: 960px) 560px, 100vw' -%}</div>
        <div class="ip-slide" data-slide="3" hidden>{%- render 'ip-media', image: img_15, id: 'IMG-15', label: 'Scale: the printer in an adult hand next to a mug', size: '1600 × 1200 px · 4:3', ratio: '4/3', sizes: '(min-width: 960px) 560px, 100vw' -%}</div>
        <div class="ip-slide" data-slide="4" hidden>{%- render 'ip-media', image: img_24, id: 'IMG-24', label: 'Unboxing: the gift box opened by the child', size: '1600 × 1200 px · 4:3', ratio: '4/3', sizes: '(min-width: 960px) 560px, 100vw' -%}</div>
        <div class="ip-slide" data-slide="5" hidden>{%- render 'ip-media', image: img_25, id: 'IMG-25', label: 'Real customer photo (after the first sales)', size: '1600 × 1200 px · 4:3', ratio: '4/3', sizes: '(min-width: 960px) 560px, 100vw' -%}</div>
      </div>
      <div class="ip-thumbs" role="group" aria-label="Choose an image">
        {%- assign thumbs = 'IMG-01,IMG-03,IMG-04,IMG-15,IMG-24,IMG-25' | split: ',' -%}
        {%- for t in thumbs -%}
          {%- case forloop.index0 -%}{%- when 0 -%}{%- assign ti = img_01 -%}{%- when 1 -%}{%- assign ti = img_03 -%}{%- when 2 -%}{%- assign ti = img_04 -%}{%- when 3 -%}{%- assign ti = img_15 -%}{%- when 4 -%}{%- assign ti = img_24 -%}{%- else -%}{%- assign ti = img_25 -%}{%- endcase -%}
          <button type="button" data-thumb="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}>{% if ti != blank %}{{ ti | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{% else %}{{ t }}{% endif %}</button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<!-- S3 Numbers -->
<div class="ip-numbers">
  <div class="ip-wrap row">
    <div><div class="big">5<small>s</small></div><p>from idea to sticker</p></div>
    <div><div class="big">0</div><p>ink cartridges, ever</p></div>
    <div><div class="big">{{ s.starter_stickers }}</div><p>stickers in the box</p></div>
  </div>
</div>

<!-- S4 How it works -->
<section class="alt" id="ip-how">
  <div class="ip-wrap">
    <div class="ip-narrow ip-center"><p class="ip-eyebrow">How it works</p><h2>They say it. It prints. They color it.</h2></div>
    <div class="ip-steps">
      <div class="ip-step"><div class="m">{%- render 'ip-media', image: img_05, id: 'IMG-05', label: 'Step 1: the child presses the button and talks', size: '1600 × 1200 px · 4:3', ratio: '4/3', sizes: '(min-width: 860px) 340px, 96px' -%}</div>
        <div><p class="n">1</p><h3>They press and say their idea</h3><p class="quote">“A cat astronaut eating ice cream!”</p></div></div>
      <div class="ip-step"><div class="m">{%- render 'ip-media', image: img_06, id: 'IMG-06', label: 'Step 2: 3-second loop of the sticker printing', size: '1600 × 1200 px · 4:3', ratio: '4/3', sizes: '(min-width: 860px) 340px, 96px' -%}</div>
        <div><p class="n">2</p><h3>The sticker prints in 5 seconds</h3><p>Bzzz… the printer draws their idea and prints it in black and white, with no ink.</p></div></div>
      <div class="ip-step"><div class="m">{%- render 'ip-media', image: img_07, id: 'IMG-07', label: 'Step 3: the child colors the sticker and sticks it', size: '1600 × 1200 px · 4:3', ratio: '4/3', sizes: '(min-width: 860px) 340px, 96px' -%}</div>
        <div><p class="n">3</p><h3>They color it and stick it everywhere</h3><p>Notebooks, the fridge, a card for Grandma: their ideas become real things.</p></div></div>
    </div>

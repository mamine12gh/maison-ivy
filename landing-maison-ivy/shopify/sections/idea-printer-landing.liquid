{%- comment -%}
  Landing page "The Idea Printer" (Maison Ivy): sections S0 to S17 of the final proposal.
  Images: every visual is an image setting of this section; empty = placeholder at the size to produce.
{%- endcomment -%}
{%- liquid
  for block in section.blocks
    case block.settings.slot
      when 'img_01'
        assign img_01 = block.settings.image
      when 'img_03'
        assign img_03 = block.settings.image
      when 'img_04'
        assign img_04 = block.settings.image
      when 'img_15'
        assign img_15 = block.settings.image
      when 'img_24'
        assign img_24 = block.settings.image
      when 'img_25'
        assign img_25 = block.settings.image
      when 'img_05'
        assign img_05 = block.settings.image
      when 'img_06'
        assign img_06 = block.settings.image
      when 'img_07'
        assign img_07 = block.settings.image
      when 'img_08'
        assign img_08 = block.settings.image
      when 'img_09'
        assign img_09 = block.settings.image
      when 'img_10'
        assign img_10 = block.settings.image
      when 'img_11'
        assign img_11 = block.settings.image
      when 'img_12'
        assign img_12 = block.settings.image
      when 'img_13'
        assign img_13 = block.settings.image
      when 'img_14'
        assign img_14 = block.settings.image
      when 'img_23a'
        assign img_23a = block.settings.image
      when 'img_23b'
        assign img_23b = block.settings.image
      when 'img_23c'
        assign img_23c = block.settings.image
      when 'img_16'
        assign img_16 = block.settings.image
      when 'img_17'
        assign img_17 = block.settings.image
      when 'img_18'
        assign img_18 = block.settings.image
      when 'img_19'
        assign img_19 = block.settings.image
      when 'img_20'
        assign img_20 = block.settings.image
      when 'img_21'
        assign img_21 = block.settings.image
      when 'img_22'
        assign img_22 = block.settings.image
    endcase
  endfor
-%}
{%- liquid
  assign s = section.settings
  assign v_starter = product.variants[0]
  assign v_creative = product.variants[1]
  assign v_siblings = product.variants[2]
  assign default_variant = v_creative | default: product.selected_or_first_available_variant

  assign roll_price = 500
  assign markers_price = 1200
  assign binder_price = 900
  if s.refill_product != blank
    assign roll_price = s.refill_product.price | divided_by: 5
  endif
  if s.markers_product != blank
    assign markers_price = s.markers_product.price
  endif
  if s.binder_product != blank
    assign binder_price = s.binder_product.price
  endif

  assign starter_price = v_starter.price | default: 7900
  assign creative_value = roll_price | times: 7 | plus: markers_price | plus: binder_price | plus: starter_price
  assign siblings_value = roll_price | times: 4 | plus: starter_price | plus: starter_price
  assign creative_save = creative_value | minus: v_creative.price
  assign siblings_save = siblings_value | minus: v_siblings.price
  assign starter_unit = v_starter.price | divided_by: s.starter_stickers
  assign creative_unit = v_creative.price | divided_by: s.creative_stickers
  assign siblings_unit = v_siblings.price | divided_by: 2

  assign show_rating = false
  assign shown_count = s.review_count
  if s.review_count >= 10
    assign show_rating = true
  elsif s.show_examples
    assign show_rating = true
    assign shown_count = 126
  endif
  assign cta = s.cta_label | default: 'Get my Idea Printer'
-%}

<style>
  .ip{--coral:#FF5A36;--cta:#E8431F;--cta-h:#D23714;--yellow:#FFC83D;--ink:#1E1B2E;--cream:#FFF6EC;--cream-2:#FBEAD6;--paper:#FFFFFF;--sky:#2F5BEA;--green:#1E8A5E;--muted:#5F5870;--line:#EADFD2;
    --f-display:'Fredoka','Nunito',ui-rounded,system-ui,sans-serif;--f-body:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;--f-hand:'Caveat','Comic Sans MS',cursive;
    --r-s:12px;--r-m:20px;--r-l:28px;--shadow:0 10px 30px -12px rgba(30,27,46,.25);--wrap:1120px;
    background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased;padding-bottom:84px}
  body{margin:0;background:#fff}
  .ip *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.ip *{animation:none!important;transition:none!important}}
  .ip h1,.ip h2,.ip h3{font-family:var(--f-display);font-weight:700;line-height:1.08;margin:0;text-wrap:balance;letter-spacing:-.01em;color:var(--ink)}
  .ip h2{font-size:clamp(28px,6.4vw,42px)}
  .ip h3{font-size:20px;font-weight:600;line-height:1.2}
  .ip p{margin:0}
  .ip a{color:var(--sky)}
  .ip :where(button){font:inherit;color:inherit}
  .ip :focus-visible{outline:3px solid var(--sky);outline-offset:3px;border-radius:6px}
  .ip [hidden]{display:none!important}
  .ip-wrap{max-width:var(--wrap);margin:0 auto;padding-inline:16px}
  .ip-narrow{max-width:640px;margin:0 auto}
  .ip section{padding-block:56px}
  .ip .alt{background:var(--cream)}
  .ip-eyebrow{font-weight:800;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--cta);margin-bottom:10px}
  .ip-center{text-align:center}
  .ip-ex{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;background:#E9EEFF;color:#1B2A6B;border-radius:4px;padding:1px 6px;justify-self:start;display:inline-block}
  .ip-preview{font-family:ui-monospace,Menlo,monospace;font-size:12px;background:#E9EEFF;color:#1B2A6B;border-bottom:1px dashed #9AAAE8;padding:8px 16px;text-align:center}
  .ip-img{display:block;width:100%;height:auto;object-fit:cover;border-radius:inherit;max-width:100%}
  .ip-ph{display:grid;place-content:center;justify-items:center;gap:4px;text-align:center;padding:14px;width:100%;max-width:100%;border-radius:inherit;
    background:repeating-linear-gradient(135deg,rgba(30,27,46,.035) 0 10px,transparent 10px 20px),var(--cream-2);color:var(--muted);font-size:13px;line-height:1.3}
  .ip-ph svg{width:28px;height:28px;color:var(--coral)}
  .ip-ph b{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:var(--ink)}
  .ip-ph span{max-width:32ch}
  .ip-ph small{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:var(--cta)}

  /* S0 / S1 */
  .ip-bar{background:var(--ink);color:var(--cream);font-size:13px;font-weight:700;text-align:center;padding:8px 16px}
  .ip-bar i{font-style:normal;color:var(--yellow);margin-inline:6px}
  .ip-bar span{white-space:nowrap}
  .ip-top{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;max-width:var(--wrap);margin:0 auto}
  .ip-logo{font-family:var(--f-display);font-weight:700;font-size:28px;letter-spacing:-.02em;color:var(--ink)!important;text-decoration:none;line-height:1;white-space:pre}
  .ip-logo .iv{position:relative;display:inline-block}
  .ip-logo .iv svg{position:absolute;width:.42em;height:.42em;left:50%;top:-.07em;transform:translateX(-42%)}
  .ip-cart{position:relative;width:44px;height:44px;border-radius:50%;border:0;background:transparent;display:grid;place-items:center;cursor:pointer}
  .ip-cart svg{width:26px;height:26px}
  .ip-cart .n{position:absolute;top:4px;right:2px;background:var(--cta);color:#fff;font-size:11px;font-weight:800;min-width:18px;height:18px;border-radius:9px;display:grid;place-items:center;padding:0 4px}

  /* boutons */
  .ip-cta{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:58px;padding:14px 22px;border:0;border-radius:999px;background:var(--cta);color:#fff!important;font-family:var(--f-display);font-weight:600;font-size:20px;text-decoration:none;cursor:pointer;box-shadow:0 6px 0 var(--cta-h);transition:transform .12s,box-shadow .12s,background .12s}
  .ip-cta:hover{background:var(--cta-h)}
  .ip-cta:active{transform:translateY(4px);box-shadow:0 2px 0 var(--cta-h)}
  .ip-cta[disabled]{opacity:.6;cursor:wait}
  .ip-cta .arr{transition:transform .2s}
  .ip-cta:hover .arr{transform:translateX(4px)}
  .ip-cta.pulse{animation:ip-pulse 1.6s ease-out 1.2s 2}
  @keyframes ip-pulse{0%{box-shadow:0 6px 0 var(--cta-h),0 0 0 0 rgba(232,67,31,.45)}100%{box-shadow:0 6px 0 var(--cta-h),0 0 0 18px rgba(232,67,31,0)}}
  .ip-ghost{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:52px;border:2px solid var(--ink);background:transparent;border-radius:999px;font-weight:800;font-size:17px;color:var(--ink)!important;text-decoration:none;cursor:pointer}
  .ip-sec-cta{max-width:420px;margin:32px auto 0}
  .ip-reassure{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 14px;margin-top:12px;font-size:13.5px;color:var(--muted);font-weight:700}
  .ip-reassure span{display:inline-flex;align-items:center;gap:5px}
  .ip-reassure svg{width:16px;height:16px;color:var(--green)}

  /* S2 hero */
  .ip-hero{padding-block:8px 40px!important}
  .ip-hero-grid{display:grid;gap:18px}
  .ip-hero-text{display:grid;gap:14px;align-content:start}
  .ip-badges{display:flex;flex-wrap:wrap;gap:8px}
  .ip-badge{display:inline-flex;align-items:center;gap:6px;background:var(--cream);border:1.5px solid var(--line);border-radius:999px;padding:5px 12px;font-size:14px;font-weight:800}
  .ip-badge svg{width:16px;height:16px}
  .ip-badge.y{background:var(--yellow);border-color:var(--yellow)}
  .ip-hero h1{font-size:clamp(34px,9.2vw,60px);text-wrap:initial}
  .ip-hero h1 em{font-style:normal;color:var(--cta)}
  .ip-stars{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:var(--muted);flex-wrap:wrap}
  .ip-stars .s{color:#F2A900;letter-spacing:1px;font-size:17px}
  .ip-stars a{color:var(--muted)}
  .ip-sub{font-size:18px;color:#3A3550}
  .ip-price-line{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;font-weight:700}
  .ip-price-line .from{font-size:15px;color:var(--muted)}
  .ip-price-line .p{font-family:var(--f-display);font-size:30px;font-weight:700}
  .ip-price-line .free{font-size:15px;color:var(--green)}
  .ip-media{display:grid;gap:10px;min-width:0}
  .ip-stage{position:relative;border-radius:var(--r-l);overflow:hidden;background:var(--cream)}
  .ip-stage > .ip-slide{border-radius:var(--r-l);overflow:hidden}
  .ip-stage video{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
  .ip-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
  .ip-thumbs button{border-radius:12px;border:2px solid transparent;background:var(--cream-2);padding:0;cursor:pointer;overflow:hidden;font-family:ui-monospace,Menlo,monospace;font-size:10px;color:var(--muted);height:52px}
  .ip-thumbs button[aria-current="true"]{border-color:var(--ink)}
  .ip-thumbs img{width:100%;height:100%;object-fit:cover;display:block}
  @media (min-width:960px){.ip-hero{padding-block:24px 64px!important}.ip-hero-grid{grid-template-columns:1.08fr 1fr;gap:48px;align-items:center}.ip-hero-text{order:2}.ip-media{order:1}}
  @media (max-width:959px){.ip-hero-grid{display:flex;flex-direction:column}.ip-hero-text{display:contents}.ip-h-top{order:1;display:grid;gap:10px}.ip-media{order:2}.ip-h-bottom{order:3;display:grid;gap:14px}.ip-badge{font-size:13.5px;padding:4px 10px}.ip-thumbs button{height:44px}}

  /* S3 */
  .ip-numbers{padding-block:28px;background:var(--ink);color:var(--cream)}
  .ip-numbers .row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;text-align:center;max-width:820px;margin:0 auto}
  .ip-numbers .big{font-family:var(--f-display);font-weight:700;font-size:clamp(34px,10vw,56px);line-height:1;color:var(--yellow)}
  .ip-numbers .big small{font-size:.5em;margin-left:2px}
  .ip-numbers p{font-size:14px;font-weight:700;margin-top:6px;opacity:.92}

  /* S4 */
  .ip-steps{display:grid;gap:18px;margin-top:28px}
  .ip-step{display:grid;grid-template-columns:96px 1fr;gap:14px;align-items:center}
  .ip-step .m{border-radius:var(--r-m);overflow:hidden}
  .ip-step .n{font-family:var(--f-display);font-weight:700;font-size:15px;color:var(--cta)}
  .ip-step h3{margin:2px 0 4px}
  .ip-step p{color:var(--muted);font-size:16px}
  .ip-step .quote{font-family:var(--f-hand);font-size:23px;color:var(--ink);line-height:1.1}
  .ip-step .ip-ph{font-size:10.5px;padding:6px}.ip-step .ip-ph span{display:none}
  .ip-ai{margin-top:24px;background:var(--paper);border:1.5px dashed var(--line);border-radius:var(--r-m);padding:14px 16px;font-size:15px;color:var(--muted)}
  @media (min-width:860px){.ip-steps{grid-template-columns:repeat(3,1fr);gap:28px}.ip-step{grid-template-columns:1fr}.ip-step .ip-ph span{display:block}}

  /* S5 */
  .ip-ideas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:28px}
  .ip-idea{background:var(--paper);border-radius:var(--r-m);padding:14px 12px 16px;display:grid;gap:10px;justify-items:center;text-align:center;border:1.5px solid var(--line);margin:0}
  .ip-idea q{font-family:var(--f-hand);font-weight:700;font-size:22px;line-height:1.05}
  .ip-idea .arrow{width:22px;height:22px;color:var(--coral)}
  .ip-idea .st{width:min(130px,100%);border-radius:6px;overflow:hidden;box-shadow:0 1px 0 #E3D8CB,0 8px 18px -10px rgba(30,27,46,.45);transform:rotate(-2deg)}
  .ip-idea:nth-child(even) .st{transform:rotate(2.2deg)}
  .ip-idea .st .ip-ph{font-size:10.5px;padding:6px}.ip-idea .st .ip-ph span{display:none}
  .ip-note{text-align:center;font-size:14px;color:var(--muted);margin-top:16px}
  @media (min-width:860px){.ip-ideas{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.ip-idea .st{width:160px}}

  /* S6 */
  .ip-ben-grid{display:grid;gap:28px;margin-top:28px}
  .ip-benefits{display:grid;gap:14px}
  .ip-benefit{display:grid;grid-template-columns:48px 1fr;gap:14px;align-items:start;background:var(--paper);border-radius:var(--r-m);padding:16px;border:1.5px solid var(--line)}
  .ip-benefit .ic{width:48px;height:48px;border-radius:14px;background:var(--yellow);display:grid;place-items:center}
  .ip-benefit .ic svg{width:26px;height:26px}
  .ip-benefit h3{font-size:19px}
  .ip-benefit h3 span{color:var(--muted);font-family:var(--f-body);font-weight:700;font-size:15px;display:block;margin-top:3px}
  .ip-benefit p{font-size:15.5px;color:var(--muted);margin-top:6px}
  .ip-exploded{border-radius:var(--r-l);overflow:hidden}
  .ip-callouts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
  .ip-callouts div{background:var(--paper);border:1.5px solid var(--line);border-radius:var(--r-s);padding:8px 10px;font-size:14px;font-weight:700}
  .ip-callouts small{display:block;font-weight:600;color:var(--muted);font-size:12.5px}
  .ip-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .ip-pill{background:var(--ink);color:var(--cream);border-radius:999px;padding:6px 12px;font-size:14px;font-weight:800}
  .ip-specs{margin-top:16px;border-top:1.5px solid var(--line);padding-top:10px}
  .ip-specs summary{cursor:pointer;font-weight:800;min-height:44px;display:flex;align-items:center}
  .ip-specs dl{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:14.5px;margin:6px 0 0}
  .ip-specs dt{color:var(--muted)}.ip-specs dd{margin:0;font-weight:700}
  @media (min-width:960px){.ip-ben-grid{grid-template-columns:1fr 1fr;align-items:start;gap:48px}.ip-ben-media{order:-1}}

  /* S7 */
  .ip-offer{background:var(--cream)}
  .ip-offer-grid{display:grid;gap:24px;margin-top:24px}
  .ip-quiz{background:var(--paper);border-radius:var(--r-m);padding:16px;border:1.5px solid var(--line)}
  .ip-quiz p{font-weight:800}
  .ip-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  .ip-chip{min-height:44px;padding:6px 14px;border-radius:999px;border:2px solid var(--line);background:var(--paper);font-weight:800;cursor:pointer;font-size:15.5px;flex:none}
  .ip-chip[aria-pressed="true"]{border-color:var(--ink);background:var(--yellow)}
  .ip-quiz-out{margin-top:10px;font-family:var(--f-hand);font-size:23px;line-height:1.15;color:var(--cta)}
  .ip-quiz-out:empty{display:none}
  .ip-packs{display:grid;gap:12px;border:0;padding:0;margin:0;min-width:0}
  .ip-packs legend{font-family:var(--f-display);font-weight:700;font-size:26px;margin-bottom:12px;padding:0}
  .ip-pack{position:relative;display:grid;grid-template-columns:24px 64px 1fr auto;gap:12px;align-items:center;background:var(--paper);border:2.5px solid var(--line);border-radius:var(--r-m);padding:14px;cursor:pointer}
  .ip-pack:has(.tag){padding-top:24px}
  .ip-pack input{appearance:none;-webkit-appearance:none;width:24px;height:24px;border-radius:50%;border:2.5px solid #B9AEC4;margin:0;display:grid;place-items:center;cursor:pointer}
  .ip-pack input:checked{border-color:var(--cta)}
  .ip-pack input:checked::after{content:"";width:12px;height:12px;border-radius:50%;background:var(--cta)}
  .ip-pack:has(input:checked){border-color:var(--cta);box-shadow:0 0 0 4px rgba(232,67,31,.12)}
  .ip-pack .thumb{width:64px;height:64px;border-radius:14px;overflow:hidden;background:var(--cream-2)}
  .ip-pack .thumb .ip-ph{height:64px;font-size:9px;padding:2px}.ip-pack .thumb .ip-ph span,.ip-pack .thumb .ip-ph svg{display:none}
  .ip-pack .name,.ip-pack .desc,.ip-pack .unit{display:block}
  .ip-pack .name{font-family:var(--f-display);font-weight:600;font-size:19px;line-height:1.1}
  .ip-pack .desc{font-size:14px;color:var(--muted);line-height:1.35;margin-top:3px}
  .ip-pack .unit{font-size:13px;font-weight:800;color:var(--green);margin-top:4px}
  .ip-pack .pr{text-align:right;white-space:nowrap}
  .ip-pack .pr b{display:block;font-family:var(--f-display);font-size:22px}
  .ip-pack .tag{position:absolute;top:-12px;left:52px;background:var(--ink);color:var(--yellow);font-size:12px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;border-radius:999px;padding:3px 10px}
  .ip-save{display:inline-block;background:#E3F4EC;color:var(--green);font-weight:900;font-size:12.5px;border-radius:6px;padding:2px 7px;margin-top:4px}
  .ip-buybox{background:var(--paper);border-radius:var(--r-l);padding:20px;border:1.5px solid var(--line);box-shadow:var(--shadow);display:grid;gap:14px;align-content:start;min-width:0}
  .ip-inbox h3{font-size:17px;font-family:var(--f-body);font-weight:900}
  .ip-inbox ul{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:7px}
  .ip-inbox li{display:grid;grid-template-columns:22px 1fr auto;gap:8px;align-items:center;font-size:15px}
  .ip-inbox li svg{width:20px;height:20px;color:var(--green)}
  .ip-inbox li em{font-style:normal;color:var(--muted);font-size:13.5px}
  .ip-inbox .note{font-size:12.5px;color:var(--muted);margin-top:6px}
  .ip-total{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;border-top:1.5px dashed var(--line);padding-top:14px}
  .ip-total .only{font-weight:800;color:var(--muted)}
  .ip-total .big{font-family:var(--f-display);font-weight:700;font-size:44px;line-height:1;color:var(--cta)}
  .ip-total s{color:#8B8398;font-weight:700;font-size:18px}
  .ip-total .ip-save{font-size:14px}
  .ip-form{display:grid;gap:10px}
  .ip-form .shopify-payment-button__button{border-radius:12px;min-height:48px}
  .ip-form .shopify-payment-button__more-options{display:none}
  .ip-terms{font-size:14px;text-align:center;color:var(--muted)}
  .ip-guar{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .ip-guar div{display:flex;gap:8px;align-items:center;font-size:13.5px;font-weight:800;background:var(--cream);border-radius:12px;padding:9px 10px;line-height:1.25}
  .ip-guar svg{width:22px;height:22px;flex:none}
  .ip-gift{display:flex;gap:10px;align-items:center;font-size:14.5px;font-weight:700;background:#FFF3C9;border-radius:12px;padding:10px 12px}
  .ip-gift svg{width:22px;height:22px;flex:none;color:var(--cta)}
  .ip-error{color:var(--sky);font-weight:800;font-size:14px}
  @media (min-width:960px){.ip-offer-grid{grid-template-columns:1.05fr 1fr;align-items:start;gap:40px}.ip-buybox{position:sticky;top:20px}}

  /* S8 */
  .ip-cmp-wrap{overflow-x:auto;margin-top:28px;border-radius:var(--r-m);border:1.5px solid var(--line)}
  .ip-cmp{width:100%;border-collapse:collapse;background:var(--paper);font-size:15px}
  .ip-cmp th,.ip-cmp td{padding:12px 8px;text-align:center;border-bottom:1px solid var(--line)}
  .ip-cmp th:first-child,.ip-cmp td:first-child{text-align:left;font-weight:700;width:46%}
  .ip-cmp thead th{font-family:var(--f-display);font-weight:600;font-size:15px;line-height:1.15;background:var(--cream)}
  .ip-cmp thead th.us{background:var(--ink);color:var(--yellow)}
  .ip-cmp td.us{background:#FFF1EC}
  .ip-cmp tr:last-child td{border-bottom:0}
  .ip-yes,.ip-no{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%}
  .ip-yes{background:#E3F4EC;color:var(--green)}.ip-no{background:#F1EEF4;color:#8B8398}
  .ip-yes svg,.ip-no svg{width:16px;height:16px}

  /* S9 */
  .ip-emo-grid{display:grid;gap:20px;margin-top:24px}
  .ip-emo-img{border-radius:var(--r-l);overflow:hidden}
  .ip-moments{display:grid;gap:12px}
  .ip-moment{display:grid;grid-template-columns:76px 1fr;gap:14px;align-items:center;background:var(--paper);border-radius:var(--r-m);padding:10px;border:1.5px solid var(--line)}
  .ip-moment .m{border-radius:14px;overflow:hidden}
  .ip-moment .ip-ph{font-size:9px;padding:3px}.ip-moment .ip-ph span,.ip-moment .ip-ph svg{display:none}
  .ip-moment h3{font-size:17.5px}
  .ip-moment p{font-size:14.5px;color:var(--muted);margin-top:3px}
  @media (min-width:960px){.ip-emo-grid{grid-template-columns:1.2fr 1fr;align-items:center;gap:40px}}

  /* S10 */
  .ip-testis{display:grid;gap:14px;margin-top:28px}
  .ip-testi{background:var(--paper);border-radius:var(--r-m);overflow:hidden;border:1.5px solid var(--line);display:grid}
  .ip-testi .body{padding:16px;display:grid;gap:8px}
  .ip-testi blockquote{margin:0;font-size:17px;font-weight:700;line-height:1.4}
  .ip-testi .who{font-size:14px;color:var(--muted)}
  .ip-testi .who b{color:var(--ink)}
  @media (min-width:860px){.ip-testis{grid-template-columns:repeat(3,1fr)}}

  /* S11 */
  .ip-rev-head{display:grid;gap:18px;margin-top:24px;background:var(--paper);border-radius:var(--r-m);padding:18px;border:1.5px solid var(--line)}
  .ip-score{display:flex;align-items:center;gap:14px}
  .ip-score .big{font-family:var(--f-display);font-weight:700;font-size:52px;line-height:1}
  .ip-score .s{color:#F2A900;font-size:20px;letter-spacing:2px}
  .ip-score small{display:block;color:var(--muted);font-weight:700;font-size:14px}
  .ip-dist{display:grid;gap:6px;font-size:13.5px;font-weight:700}
  .ip-dist div{display:grid;grid-template-columns:28px 1fr 40px;gap:8px;align-items:center}
  .ip-dist .tr{height:8px;border-radius:4px;background:#F1EAE1;overflow:hidden}
  .ip-dist .tr i{display:block;height:100%;background:#F2A900;border-radius:4px}
  .ip-dist span:last-child{text-align:right;color:var(--muted)}
  .ip-filters{display:flex;gap:8px;overflow-x:auto;padding:16px 16px 4px;margin-inline:-16px;scrollbar-width:none}
  .ip-reviews{display:grid;gap:12px;margin-top:10px}
  .ip-review{background:var(--paper);border-radius:var(--r-m);padding:16px;border:1.5px solid var(--line);display:grid;gap:8px}
  .ip-review .top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
  .ip-review .s{color:#F2A900;letter-spacing:1px}.ip-review .off{color:#DDD3C6}
  .ip-review .ver{font-size:12.5px;color:var(--green);font-weight:800}
  .ip-review p{font-size:15.5px}
  .ip-review .who{font-size:13.5px;color:var(--muted);font-weight:700}
  .ip-review .tagl{font-size:12px;font-weight:800;color:var(--muted);background:var(--cream);border-radius:6px;padding:2px 8px}
  @media (min-width:860px){.ip-rev-head{grid-template-columns:auto 1fr;align-items:center;gap:40px}.ip-reviews{grid-template-columns:1fr 1fr}}

  /* S12 */
  .ip-promise{background:var(--yellow)!important}
  .ip-promise .box{display:grid;gap:18px;align-items:center}
  .ip-seal{width:120px;height:120px;border-radius:50%;background:var(--ink);color:var(--yellow);display:grid;place-content:center;text-align:center;font-family:var(--f-display);font-weight:700;line-height:1;transform:rotate(-8deg);margin:0 auto}
  .ip-seal b{font-size:44px;display:block}.ip-seal span{font-size:14px}
  .ip-promise p{font-size:18px;margin-top:8px}
  .ip-promise ul{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-wrap:wrap;gap:8px}
  .ip-promise li{background:rgba(255,255,255,.6);border-radius:999px;padding:6px 12px;font-weight:800;font-size:14.5px}
  @media (min-width:860px){.ip-promise .box{grid-template-columns:160px 1fr;gap:36px}.ip-seal{width:150px;height:150px}}

  /* S13 */
  .ip-faq{margin-top:24px;display:grid;gap:10px}
  .ip-faq details{background:var(--paper);border-radius:var(--r-m);border:1.5px solid var(--line)}
  .ip-faq summary{list-style:none;cursor:pointer;padding:16px 52px 16px 18px;font-weight:800;font-size:17px;position:relative;min-height:56px;display:flex;align-items:center}
  .ip-faq summary::-webkit-details-marker{display:none}
  .ip-faq summary::after{content:"";position:absolute;right:20px;top:50%;width:12px;height:12px;border-right:3px solid var(--ink);border-bottom:3px solid var(--ink);transform:translateY(-70%) rotate(45deg);transition:transform .2s}
  .ip-faq details[open] summary::after{transform:translateY(-30%) rotate(-135deg)}
  .ip-faq .a{padding:0 18px 18px;color:#3A3550;font-size:16px}

  /* S14 / S15 */
  .ip-last{display:grid;gap:14px;text-align:center}
  .ip-last .btns{display:grid;gap:12px;max-width:420px;margin:10px auto 0;width:100%}
  .ip-contact{font-size:15px;color:var(--muted);font-weight:700}
  .ip-contact b{color:var(--ink);user-select:all}
  .ip-footer{background:var(--ink);color:#CFC9DA;padding-block:36px 40px;font-size:14px}
  .ip-footer .ip-wrap{display:grid;gap:18px}
  .ip-footer .ip-logo{color:var(--cream)!important;font-size:26px}
  .ip-footer nav{display:flex;flex-wrap:wrap;gap:6px 16px}
  .ip-footer nav a{color:#CFC9DA}
  .ip-pay{display:flex;flex-wrap:wrap;gap:6px}
  .ip-pay svg{height:24px;width:auto}

  /* S16 */
  .ip-sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1.5px solid var(--line);box-shadow:0 -8px 24px -16px rgba(30,27,46,.4);padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));transform:translateY(110%);transition:transform .25s}
  .ip-sticky.on{transform:none}
  .ip-sticky .in{max-width:720px;margin:0 auto;display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:10px;align-items:center}
  .ip-sticky .thumb{width:48px;height:48px;border-radius:12px;overflow:hidden;background:var(--cream-2)}
  .ip-sticky .thumb .ip-ph{height:48px;font-size:8px;padding:1px}.ip-sticky .thumb .ip-ph span,.ip-sticky .thumb .ip-ph svg,.ip-sticky .thumb .ip-ph small{display:none}
  .ip-sticky .t{min-width:0;line-height:1.2}
  .ip-sticky .t b{display:block;font-family:var(--f-display);font-size:20px}
  .ip-sticky .t span{font-size:12.5px;color:var(--green);font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
  .ip-sticky .ip-cta{min-height:52px;font-size:16px;padding:10px 16px;width:auto;box-shadow:0 4px 0 var(--cta-h)}

  /* S17 */
  .ip-scrim{position:fixed;inset:0;background:rgba(30,27,46,.45);z-index:50;opacity:0;pointer-events:none;transition:opacity .2s}
  .ip-scrim.on{opacity:1;pointer-events:auto}
  .ip-drawer{position:fixed;z-index:60;top:0;right:0;bottom:0;width:min(420px,100%);background:var(--paper);transform:translateX(105%);transition:transform .28s;display:grid;grid-template-rows:auto 1fr auto;visibility:hidden}
  .ip-drawer.on{transform:none;visibility:visible}
  .ip-drawer .hd{display:flex;justify-content:space-between;align-items:center;padding:16px;border-bottom:1.5px solid var(--line)}
  .ip-drawer .hd b{font-family:var(--f-display);font-size:21px;color:var(--green)}
  .ip-x{width:44px;height:44px;border-radius:50%;border:0;background:var(--cream);cursor:pointer;font-size:22px;line-height:1}
  .ip-drawer .bd{padding:16px;overflow:auto;display:grid;gap:14px;align-content:start}
  .ip-line{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:10px}
  .ip-line b{font-family:var(--f-display);font-weight:600}
  .ip-line small{display:block;color:var(--muted);font-size:13px}
  .ip-upsell{border:2px dashed var(--line);border-radius:var(--r-m);padding:12px;display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center}
  .ip-upsell p{font-size:14.5px}.ip-upsell p b{display:block}
  .ip-upsell button{min-height:44px;border-radius:999px;border:2px solid var(--ink);background:var(--paper);font-weight:900;padding:0 14px;cursor:pointer}
  .ip-drawer .ft{padding:16px 16px calc(16px + env(safe-area-inset-bottom,0px));border-top:1.5px solid var(--line);display:grid;gap:10px}
  .ip-drawer .sum{display:flex;justify-content:space-between;font-weight:900;font-size:18px}
  .ip-drawer .ship{font-size:13.5px;color:var(--green);font-weight:800}
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="ip-o" viewBox="0 0 40 40"><defs><mask id="ip-lm"><rect x="-5" y="-5" width="50" height="50" fill="#fff"/><path d="M15 1 L38 24 L50 24 L50 -10 L15 -10 Z" fill="#000"/></mask></defs><g mask="url(#ip-lm)" fill="#FF5A36"><circle cx="20" cy="19" r="16"/><path d="M8.5 27 L4 38.5 L17.5 33.5 Z"/></g><path d="M17.24 3.24 Q16.88 22.12 35.76 21.76 Z" fill="#FFE1D6" stroke="#E8431F" stroke-width="1.2" stroke-linejoin="round"/></symbol>
    <symbol id="ip-check" viewBox="0 0 24 24"><path d="M5 12.5 L10 17 L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="ip-xx" viewBox="0 0 24 24"><path d="M7 7 L17 17 M17 7 L7 17" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></symbol>
    <symbol id="ip-truck" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M2 6 H14 V16 H2 Z M14 9 H18.5 L22 12.5 V16 H14"/><circle cx="6.5" cy="17.5" r="2" fill="#fff"/><circle cx="17.5" cy="17.5" r="2" fill="#fff"/></g></symbol>
    <symbol id="ip-shield" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3 L20 6 V12 Q20 18 12 21 Q4 18 4 12 V6 Z"/><path d="M8.5 12 L11 14.5 L15.5 9.5" stroke-linecap="round"/></g></symbol>
    <symbol id="ip-return" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10 H15 Q20 10 20 15 Q20 20 15 20 H9"/><path d="M8 6 L4 10 L8 14"/></g></symbol>
    <symbol id="ip-chat" viewBox="0 0 24 24"><path d="M4 5 H20 V16 H10 L5 20 V16 H4 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="ip-gift" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3.5" y="9" width="17" height="11" rx="1.5"/><path d="M2.5 9 H21.5 V6 H2.5 Z M12 6 V20"/><path d="M12 6 Q8 1.5 6.5 4.5 Q6 6 12 6 Q18 6 17.5 4.5 Q16 1.5 12 6"/></g></symbol>
    <symbol id="ip-lock" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5 V7.5 Q8 3.5 12 3.5 Q16 3.5 16 7.5 V10.5"/></g></symbol>
    <symbol id="ip-drop" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 Q18 10 18 14 A6 6 0 0 1 6 14 Q6 10 12 3 Z"/><path d="M4 4 L20 20"/></g></symbol>
    <symbol id="ip-hand" viewBox="0 0 24 24"><path d="M8 13 V5.5 a1.5 1.5 0 0 1 3 0 V11 M11 10 V4 a1.5 1.5 0 0 1 3 0 V11 M14 10 V5.5 a1.5 1.5 0 0 1 3 0 V13 M8 12 Q6 10 5 11.5 Q4.5 12.5 6.5 15.5 Q9 20 13 20 Q17 20 17 15 V12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="ip-spark" viewBox="0 0 24 24"><path d="M12 3 L13.8 10.2 L21 12 L13.8 13.8 L12 21 L10.2 13.8 L3 12 L10.2 10.2 Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
    <symbol id="ip-arrow" viewBox="0 0 24 24"><path d="M12 4 V19 M6 13 L12 19 L18 13" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="ip-bag" viewBox="0 0 24 24"><g fill="none" stroke="#1E1B2E" stroke-width="2" stroke-linejoin="round"><path d="M4.5 8 H19.5 L18.5 21 H5.5 Z"/><path d="M8.5 10 V6.5 Q8.5 3 12 3 Q15.5 3 15.5 6.5 V10" stroke-linecap="round"/></g></symbol>
    <symbol id="ip-vid" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10 L21 7 V17 L16 14 Z"/></g></symbol>
